@echo off
set "DCC_GALLERY_ADMIN_HOME=%~dp0"
powershell.exe -NoProfile -Command "$root=$env:DCC_GALLERY_ADMIN_HOME; $python=Join-Path $env:USERPROFILE '.cache\codex-runtimes\codex-primary-runtime\dependencies\python\python.exe'; if(-not(Test-Path -LiteralPath $python)){$python=(Get-Command python -ErrorAction Stop).Source}; try{$r=Invoke-RestMethod -Uri 'http://127.0.0.1:5090/api/health' -TimeoutSec 2}catch{$r=$null}; if(-not $r.ok){New-Item -ItemType Directory -Force -Path (Join-Path $root 'data') | Out-Null; Start-Process -FilePath $python -ArgumentList @((Join-Path $root 'server.py')) -WorkingDirectory $root -WindowStyle Hidden -RedirectStandardOutput (Join-Path $root 'data\server.log') -RedirectStandardError (Join-Path $root 'data\server-errors.log') | Out-Null; Start-Sleep -Seconds 1}; Start-Process 'http://127.0.0.1:5090/admin/'"
